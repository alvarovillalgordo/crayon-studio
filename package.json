{
  "name": "crayon-studio",
  "private": true,
  "version": "0.1.0",
  "description": "Canal de finanzas explicadas con dibujos. Pipeline: Remotion + edge-tts + imagenes IA, render en GitHub Actions.",
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts",
    "still": "remotion still src/index.ts",
    "player": "vite --config player/vite.config.ts",
    "player:build": "vite build --config player/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "images:gen": "node scripts/generate-images.mjs",
    "images:qa": "node scripts/qa-images.mjs",
    "images:sheet": "node scripts/contact-sheet.mjs",
    "validate": "node scripts/validate-video.mjs",
    "voice": "python3 scripts/voice.py",
    "new-video": "node scripts/new-video.mjs",
    "sfx": "node scripts/sfx.mjs"
  },
  "dependencies": {
    "@remotion/cli": "4.0.543",
    "@remotion/player": "4.0.543",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "4.0.543",
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.0.0"
  }
}
